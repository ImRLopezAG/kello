{
  "name": "kello",
  "version": "0.0.1-alpha.4",
  "description": "A contract-first reactive TypeScript backend framework for Neon and PostgreSQL.",
  "homepage": "https://github.com/ImRLopezAG/kello#readme",
  "bugs": {
    "url": "https://github.com/ImRLopezAG/kello/issues"
  },
  "license": "MIT",
  "author": "Angel Lopez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImRLopezAG/kello.git",
    "directory": "apps/kello"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./dist/core/contract/index.d.ts",
      "import": "./dist/core/contract/index.js"
    },
    "./server": {
      "types": "./dist/core/server/index.d.ts",
      "import": "./dist/core/server/index.js"
    },
    "./client": {
      "types": "./dist/core/client/index.d.ts",
      "import": "./dist/core/client/index.js"
    },
    "./react": {
      "types": "./dist/core/react/index.d.ts",
      "import": "./dist/core/react/index.js"
    },
    "./neon": {
      "types": "./dist/core/adapters/neon/index.d.ts",
      "import": "./dist/core/adapters/neon/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react/neon": {
      "types": "./dist/core/react/neon.d.ts",
      "import": "./dist/core/react/neon.js"
    },
    "./better-auth": {
      "types": "./dist/core/better-auth/index.d.ts",
      "import": "./dist/core/better-auth/index.js"
    },
    "./internal/tooling": {
      "types": "./dist/internal/tooling.d.ts",
      "import": "./dist/internal/tooling.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "scripts": {
    "build": "vp pack && bun scripts/third-party.ts",
    "typecheck": "bun check --no-script -p tsconfig.json && bun check --no-script -p tsconfig.node.json && bun check --no-script -p tsconfig.browser.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@neon/functions": "0.11.0",
    "@neon/realtime": "0.1.2",
    "@neondatabase/auth": "0.7.0-beta",
    "@orpc/client": "2.0.0-beta.46",
    "@orpc/contract": "2.0.0-beta.46",
    "@orpc/effect": "2.0.0-beta.46",
    "@orpc/openapi": "2.0.0-beta.46",
    "@orpc/server": "2.0.0-beta.46",
    "@orpc/shared": "2.0.0-beta.46",
    "@orpc/tanstack-query": "2.0.0-beta.46",
    "@orpc/valibot": "2.0.0-beta.46",
    "@standard-schema/spec": "1.1.0",
    "@tanstack/query-core": "5.104.3",
    "effect": "4.0.6",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@kello/ts-config": "workspace:*",
    "@neon/config": "1.9.2",
    "@neon/config-runtime": "1.10.1",
    "@neon/realtime-drizzle": "0.1.0",
    "@tanstack/react-query": "5.104.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "better-auth": "1.7.7",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "react": "19.3.0",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@tanstack/react-query": "^5.104.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "1.0.0-rc.5",
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "@better-auth/core": {
      "optional": true
    },
    "@better-auth/drizzle-adapter": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
