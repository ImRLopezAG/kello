{
  "name": "kello",
  "version": "0.0.0",
  "description": "A contract-first reactive TypeScript backend framework for Neon and PostgreSQL.",
  "bin": {
    "kello": "./cli.js"
  },
  "files": [
    "dist",
    "cli.js"
  ],
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./dist/core/contract/index.d.ts",
      "import": "./dist/core/contract/index.js"
    },
    "./server": {
      "types": "./dist/core/server/index.d.ts",
      "import": "./dist/core/server/index.js"
    },
    "./client": {
      "types": "./dist/core/client/index.d.ts",
      "import": "./dist/core/client/index.js"
    },
    "./react": {
      "types": "./dist/core/react/index.d.ts",
      "import": "./dist/core/react/index.js"
    },
    "./neon": {
      "types": "./dist/core/adapters/neon/index.d.ts",
      "import": "./dist/core/adapters/neon/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tooling": {
      "types": "./dist/tooling/index.d.ts",
      "import": "./dist/tooling/index.js"
    },
    "./react/neon": {
      "types": "./dist/core/react/neon.d.ts",
      "import": "./dist/core/react/neon.js"
    },
    "./next/server": {
      "types": "./dist/core/next/server.d.ts",
      "import": "./dist/core/next/server.js"
    },
    "./start/server": {
      "types": "./dist/core/start/server.d.ts",
      "import": "./dist/core/start/server.js"
    },
    "./better-auth": {
      "types": "./dist/core/better-auth/index.d.ts",
      "import": "./dist/core/better-auth/index.js"
    }
  },
  "scripts": {
    "build": "vp pack && bun scripts/third-party.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@neon/functions": "0.11.0",
    "@neon/realtime": "0.1.0",
    "@neon/sdk": "7.3.0",
    "@neondatabase/auth": "0.6.0-beta",
    "@orpc/client": "2.0.0-beta.43",
    "@orpc/contract": "2.0.0-beta.43",
    "@orpc/experimental-effect": "2.0.0-beta.43",
    "@orpc/openapi": "2.0.0-beta.43",
    "@orpc/server": "2.0.0-beta.43",
    "@orpc/shared": "2.0.0-beta.43",
    "@orpc/tanstack-query": "2.0.0-beta.43",
    "@orpc/valibot": "2.0.0-beta.43",
    "@standard-schema/spec": "1.1.0",
    "@tanstack/query-core": "5.104.3",
    "@vercel/nft": "1.11.0",
    "cron-parser": "5.10.1",
    "effect": "4.0.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "libpg-query": "18.1.5",
    "neon": "8.7.2",
    "pg": "8.23.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@kello/ts-config": "workspace:*",
    "@neon/config": "1.9.2",
    "@neon/config-runtime": "1.10.1",
    "@neon/realtime-drizzle": "0.1.0",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-start": "1.168.60",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "better-auth": "1.7.7",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.3.8",
    "react": "19.3.0",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-start": "^1.168.60",
    "better-auth": "1.7.7",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "^16.3.8",
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "@better-auth/core": {
      "optional": true
    },
    "@better-auth/drizzle-adapter": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
