diff --git a/dist/adapter.js b/dist/adapter.js
index f244cf202c44f125b5107b2f8e6cc045a5fea10a..24d8f5b1800172385572c1c0c5d06bdc431924c8 100644
--- a/dist/adapter.js
+++ b/dist/adapter.js
@@ -26,8 +26,21 @@ function drizzleAdapter() {
 function encodeDrizzleParameter(value) {
 	if (value === null || typeof value === "string" || typeof value === "number" || typeof value === "boolean" || typeof value === "bigint") return encodeTextParameter(value);
 	if (value instanceof Uint8Array) return encodeTextParameter(`\\x${encodeHex(value)}`);
+	if (Array.isArray(value)) return encodeTextParameter(encodeArray(value));
+	if (value !== null && typeof value === "object" && (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null)) return encodeTextParameter(JSON.stringify(value));
 	throw new Error("Drizzle Live produced a parameter that cannot be encoded as PostgreSQL text");
 }
+// Drizzle RC leaves PostgreSQL arrays for the driver to encode.
+// Keep non-JSON class instances (including unbound placeholders) rejected.
+function encodeArray(values) {
+	return `{${Array.from(values, (value) => {
+		if (value === null) return "NULL";
+		if (Array.isArray(value)) return encodeArray(value);
+		if (typeof value === "string") return `"${value.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`;
+		if (typeof value === "number" || typeof value === "boolean" || typeof value === "bigint") return String(value);
+		throw new Error("Drizzle Live produced an unsupported PostgreSQL array element");
+	}).join(",")}}`;
+}
 function encodeHex(value) {
 	return Array.from(value, (byte) => byte.toString(16).padStart(2, "0")).join("");
 }
