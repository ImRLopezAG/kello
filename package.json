{
  "name": "kello-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "A schema-first reactive TypeScript backend framework for PostgreSQL and Neon.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/examples/*",
    "docs/research/neon-realtime/example"
  ],
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "test:precommit": "node --test scripts/neon-precommit.test.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "check": "turbo run build typecheck test check:static",
    "dev": "turbo run dev --filter=@kello/docs",
    "test:integration": "turbo run test:integration",
    "test:browser": "turbo run test:browser",
    "test:cloud": "turbo run test:cloud",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check:static": "vp check"
  },
  "devDependencies": {
    "turbo": "2.11.6",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "drizzle-kit@1.0.0-rc.5": "patches/drizzle-kit@1.0.0-rc.5.patch",
    "@neon/config@1.9.2": "patches/@neon%2Fconfig@1.9.2.patch",
    "@neon/realtime-drizzle@0.1.0": "patches/@neon%2Frealtime-drizzle@0.1.0.patch"
  }
}
