NEON_BRANCH_ID=YOUR_PREVIEW_BRANCH
NEON_AUTH_BASE_URL=https://YOUR_BRANCH_AUTH_URL/neondb/auth
# Server only: configure on the Kello backend and the frontend SSR server.
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET
APP_ORIGINS=http://localhost:3001
# Kello resolves provider connection variables during deployment.
# Local CLI migration operations can use these environment variable names:
# LOOM_DATABASE_URL=
# LOOM_MIGRATION_DATABASE_URL=
GREETING_PREFIX=Hello
VITE_LOOM_SERVICE_URL=https://YOUR-START-LOOM-SERVICE

# Server-only destination for the same-origin authenticated RPC bridge.
LOOM_SERVICE_URL=https://YOUR-HOSTED-LOOM-SERVICE
