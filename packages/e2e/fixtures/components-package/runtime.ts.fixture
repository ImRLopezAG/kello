import assert from "node:assert/strict";
import { getTableConfig } from "drizzle-orm/pg-core";
import { createRpcRuntime, defineRpcAuth } from "kello/server";
import { createRpcHttpApp } from "kello/neon";
import { createORPCClient } from "kello/client";
import { RPCLink } from "@orpc/client/fetch";
import { application, schema, relations, scopes, exposures, procedures } from "./consumer/kello/_generated/current/router.js";

const namespaces = scopes.filter(scope => scope.schema?.tables.products).map(scope => getTableConfig(scope.schema.tables.products).schema);
assert.equal(new Set(namespaces).size, 2);
assert.equal(procedures.filter(entry => entry.scope === "first").length, 1);
assert.equal(procedures.filter(entry => entry.scope === "second").length, 1);
if (process.env.KELLO_TEST_DATABASE_URL) {
  const version = "a".repeat(64);
  const runtime = await createRpcRuntime({
    application, schema, relations, scopes, exposures, procedures, version,
    connectionString: process.env.KELLO_TEST_DATABASE_URL,
    metadataNamespace: process.env.KELLO_PACKED_METADATA_NAMESPACE,
    deployment: "packed", auth: defineRpcAuth({ allowAnonymous: true, authorize: () => {} }),
    config: { auth: { origins: ["https://packed.test"] } }, assertActive: async () => {},
  });
  try {
    const app = createRpcHttpApp({ ...runtime.auth, router: runtime.router, version });
    const client = createORPCClient(new RPCLink({
      url: "https://packed.test/api/kello/rpc",
      headers: { "x-kello-protocol": "kello-orpc-2", "x-kello-version": version },
      fetch: (url, init) => app.fetch(new Request(url, init)),
    }));
    assert.equal(await client.first.products.title(), `${namespaces[0]}:sdk`);
    assert.equal(await client.second.products.title(), `${namespaces[1]}:sdk`);
  } finally {
    await runtime.stop();
  }
}
export default { fetch: () => new Response("ok") };
