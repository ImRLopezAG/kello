{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "kello#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "kello#typecheck": {
      "dependsOn": ["build"]
    },
    "@kello/docs#typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["KELLO_TEST_DATABASE_URL", "KELLO_TEST_POOLED_DATABASE_URL", "KELLO_NODE24_EXECUTABLE"]
    },
    "test:browser": {
      "dependsOn": [
        "^build",
        "@kello/docs#build",
        "@kello/example-tasks#build",
        "@kello/example-jobs-storage#build",
        "@kello/example-integrations#build",
        "@kello/example-next#build",
        "@kello/example-start#build",
        "@kello/example-components#build"
      ],
      "cache": false,
      "passThroughEnv": ["KELLO_TEST_DATABASE_URL", "NEON_*", "APP_ORIGINS"]
    },
    "test:cloud": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "KELLO_CLOUD_PROJECT_ID",
        "KELLO_CLOUD_BRANCH_ID",
        "KELLO_CLOUD_EXAMPLE",
        "KELLO_CLOUD_CAPACITY",
        "NEON_API_KEY",
        "KELLO_CLOUD_NEON_AUTH",
        "KELLO_CLOUD_RUNTIME_ROLE",
        "KELLO_MIGRATION_DATABASE_URL",
        "VITE_NEON_AUTH_URL",
        "KELLO_CLOUD_SUITE",
        "KELLO_CLOUD_SETUP_AUTH",
        "KELLO_CLOUD_AUTH_EXAMPLE",
        "KELLO_CLOUD_SERVICES",
        "KELLO_CLOUD_LIVE",
        "KELLO_CLOUD_LIVE_MODE",
        "KELLO_CLOUD_LIVE_WORKLOAD",
        "KELLO_CLOUD_LIVE_SECONDS",
        "KELLO_CLOUD_LIVE_WARMUP_SECONDS",
        "KELLO_CLOUD_UPGRADE",
        "KELLO_CLOUD_PREVIOUS_VERSION",
        "KELLO_CLOUD_MIGRATION_ROLE",
        "KELLO_CLOUD_REGION",
        "KELLO_CLOUD_RECEIPT_DIR"
      ]
    },
    "migrate": {
      "cache": false
    },
    "deploy": {
      "cache": false
    },
    "release": {
      "cache": false
    },
    "//#check:static": {
      "dependsOn": [
        "kello#build",
        "@kello/docs#build",
        "@kello/example-tasks#build",
        "@kello/example-jobs-storage#build",
        "@kello/example-integrations#build",
        "@kello/example-next#build",
        "@kello/example-start#build",
        "@kello/example-components#build"
      ]
    },
    "@kello/example-tasks#typecheck": {
      "dependsOn": ["build"]
    },
    "@kello/example-tasks#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "kello/_generated/**", ".kello/generations/**", "kello/components/**/_generated/**"],
      "env": ["NEON_BRANCH_ID", "NEON_DEVELOPMENT_BRANCH_ID", "NEON_DATABASE_NAME", "NEON_MIGRATION_ROLE", "VITE_*"]
    },
    "@kello/example-jobs-storage#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "kello/_generated/**", ".kello/generations/**"],
      "env": ["NEON_BRANCH_ID", "NEON_DEVELOPMENT_BRANCH_ID", "NEON_DATABASE_NAME", "NEON_MIGRATION_ROLE", "VITE_*"]
    },
    "@kello/example-jobs-storage#typecheck": {
      "dependsOn": ["build"]
    },
    "@kello/docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**", "examples/kello/_generated/**", "examples/.kello/generations/**"]
    },
    "@kello/example-integrations#build": {
      "dependsOn": ["^build"],
      "outputs": ["kello/_generated/**", ".kello/generations/**"],
      "env": ["KELLO_SERVICE_URL", "NEON_*", "APP_ORIGINS"]
    },
    "@kello/example-integrations#typecheck": {
      "dependsOn": ["build"]
    },
    "@kello/example-next#build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "next-env.d.ts",
        "kello/_generated/**",
        ".kello/generations/**",
        "kello/components/**/_generated/**"
      ],
      "env": ["NEXT_PUBLIC_KELLO_SERVICE_URL", "NEON_*", "APP_ORIGINS"]
    },
    "@kello/example-next#typecheck": {
      "dependsOn": ["build"]
    },
    "@kello/example-start#build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".output/**",
        "src/routeTree.gen.ts",
        "kello/_generated/**",
        ".kello/generations/**",
        "kello/components/**/_generated/**"
      ],
      "env": ["VITE_KELLO_SERVICE_URL", "NEON_*", "APP_ORIGINS"]
    },
    "@kello/example-start#typecheck": {
      "dependsOn": ["build"]
    },
    "@kello/example-components#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "kello/_generated/**", ".kello/generations/**", "kello/components/**/_generated/**"],
      "env": ["NEON_BRANCH_ID", "NEON_DEVELOPMENT_BRANCH_ID", "NEON_DATABASE_NAME", "NEON_MIGRATION_ROLE", "VITE_*"]
    },
    "@kello/example-components#typecheck": {
      "dependsOn": ["build"]
    }
  },
  "globalDependencies": ["vite.config.ts"]
}
